---
import Base from '@/layouts/Base.astro';
import { getCollection } from 'astro:content';
const docs = (await getCollection('intel')).sort((a,b)=>a.data.order-b.data.order);
const { Content } = await docs[0].render();
---
<Base title="Webcraft Intel — bridge-work.ai">
  <section class="prose">
    <div class="kick">Process intel · the showpiece playbook</div>
    <Content />
  </section>
  <style is:global>
    .prose{max-width:780px}
    .prose h1{font-family:var(--font-display);font-weight:300;font-size:clamp(2rem,4vw,3rem);letter-spacing:-.04em;margin:8px 0 6px}
    .prose h2{font-family:var(--font-display);font-weight:500;font-size:1.35rem;margin:32px 0 0;letter-spacing:-.02em}
    .prose p{color:var(--muted);margin-top:14px;font-size:15.5px;line-height:1.7}
    .prose strong{color:var(--ink);font-weight:500}
    .prose code{font-family:var(--font-mono);font-size:.88em}
  </style>
</Base>
