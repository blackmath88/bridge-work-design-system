---
const links = [
  { href: '/', label: 'Overview' },
  { href: '/system/', label: 'System' },
  { href: '/pictograms/', label: 'Pictograms' },
  { href: '/intel/', label: 'Webcraft' },
];
const path = Astro.url.pathname;
---
<nav class="nav">
  <a class="brand" href="/">
    <svg viewBox="0 0 100 100" aria-hidden="true"><rect x="6" y="6" width="42" height="42" rx="3" fill="#1a7a6d"/><rect x="52" y="6" width="42" height="42" rx="3" fill="#3d1f47"/><rect x="6" y="52" width="42" height="42" rx="3" fill="#c48a2a"/><path d="M52 94 Q52 52 94 52 L94 94 Z" fill="#d4416b"/></svg>
    <span>bridge·work <em>system</em></span>
  </a>
  <div class="links">
    {links.map(l => <a href={l.href} class={path === l.href ? 'active' : ''}>{l.label}</a>)}
  </div>
</nav>
